# Production chat-server (Render / VPS / Docker)
# Render sets PORT automatically — do not hardcode in Render dashboard
CHAT_SERVER_PORT=3001

# MUST match config/acep.local.php ACEP_JWT_SECRET (256-bit+)
JWT_SECRET=CHANGE_ME_SAME_AS_acep.local.php

# Cafe24 PHP API (chat-server → REST SoT; messages persist via PHP, not direct MySQL)
BACKEND_URL=https://plustok.mycafe24.com/api/v1

# Optional — PHP→WS pub/sub + Socket.io multi-instance adapter
# REDIS_URL=redis://default:password@host:6379

# Frontend origin(s) — comma-separated, no trailing slash
CORS_ALLOWED_ORIGINS=https://plustok.mycafe24.com